{
	"kind": "Deployment",
	"apiVersion": "apps/v1",
	"metadata": {
		"name": "eda-operational-seats-affected-1-0",
		"annotations": {
			"kubernetes.io/change-cause": "image updated to RELEASENUMBER"
		},
		"labels": {
			"k8s-app": "eda-operational-seats-affected-1-0",
			"app": "bwce"
		}
	},
	"spec": {
		"replicas": 1,
		"revisionHistoryLimit": 5,
		"selector": {
			"matchLabels": {
				"k8s-app": "eda-operational-seats-affected-1-0"
			}
		},
		"template": {
			"metadata": {
				"name": "eda-operational-seats-affected-1-0",
				"creationTimestamp": null,
				"labels": {
					"k8s-app": "eda-operational-seats-affected-1-0",
					"app": "bwce"
				}
			},
			"spec": {
				"topologySpreadConstraints": [
					{
						"maxSkew": 1,
						"topologyKey": "kubernetes.io/hostname",
						"whenUnsatisfiable": "ScheduleAnyway",
						"labelSelector": {
							"matchLabels": {
								"k8s-app": "eda-operational-seats-affected-1-0"
							}
						}
					}
				],
				"affinity": {
					"nodeAffinity": {
						"requiredDuringSchedulingIgnoredDuringExecution": {
							"nodeSelectorTerms": [
								{
									"matchExpressions": [
										{
											"key": "hardware",
											"operator": "In",
											"values": [
												"edaosl"
											]
										}
									]
								}
							]
						}
					}
				},
				"containers": [
					{
						"name": "eda-operational-seats-affected-1-0",
						"image": "azracroslprocesproe1001.azurecr.io/osl/eda-operational-seats-affected:latest",
						"env": [
							{
								"name": "BW_PROFILE",
								"value": "docker"
							},							
							{
								"name": "APP_CONFIG_PROFILE",
								"value": "docker"
							},
							{
						   
								"name": "AZURE_VAULT",
								"value": "true"
							},
							{
								"name": "AZURE_MI_API_VERSION",
								"value": "2021-08-01"
							},
							{
								"name": "BUILD_ID",
								"value": "latest"
							},
							{
								"name": "SERVICE_NAME",
								"value": "eda-operational-seats-affected"
							},
								{
                                 "name": "eda-common-module.Connection.Solace.Password",
                                 "valueFrom": {
                                 "secretKeyRef": {
                                 "name": "eda-solace-pass",
                                 "key": "password"
                                                 }
								 }},
								 {
                                 "name": "eda-common-module.Connection.Solace.sslTrustStorePassword",
                                 "valueFrom": {
                                 "secretKeyRef": {
                                 "name": "sslpassword",
                                 "key": "password"
                                                 }
								 }}
  
  
						],
						"envFrom": [
							{
								"configMapRef": {
									"name": "edabwcommonmodule"
								}
							},							
							{
								"configMapRef": {
									"name": "eda-operationalseatsaffected"
								}
							}
						],
						"volumeMounts": [
		
							{"mountPath": "/edaconfig",
								"name": "eda-certs-volume"
							   
							}
							],	
						"resources": {
							"requests": {
								"cpu": "100m",
								"memory": "1Gi"
							},
							"limits":{
								"cpu": "1000m",
                        		"memory": "2Gi"
                     		}
						},
						"livenessProbe": {
							"failureThreshold": 20,
							"httpGet": {
								"path": "/healthcheck",
								"port": 8087
							},
							"initialDelaySeconds": 180,
							"periodSeconds": 10,
							"timeoutSeconds": 10,
							"successThreshold": 1
						},
						"readinessProbe": {
							"failureThreshold": 20,
							"httpGet": {
								"path": "/healthcheck",
								"port": 8087
							},
							"initialDelaySeconds": 180,
							"periodSeconds": 10,
							"timeoutSeconds": 10,
							"successThreshold": 1
						},
						"securityContext": {
							"privileged": false,
							"capabilities": {
                                "drop": ["NET_RAW"]
                            }
						},
						"ports": [
							{
								"containerPort": 8080
							},
							{
								"containerPort": 8087
							},
							{
								"containerPort": 7777
							}
						]
					}
				],
				"volumes": [
					{
						"name": "eda-certs-volume",
						"persistentVolumeClaim": {
							"claimName": "eda-certs-volume-pvc",
							"readOnly": false
						}
					}
				]
			}
		}
	}
}