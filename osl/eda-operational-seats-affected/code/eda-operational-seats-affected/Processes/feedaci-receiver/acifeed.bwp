                                    paramName="password" paramType="string"/>
                                    <methodParameter
                                    paramName="vpnName" paramType="string"/>
                                    <methodParameter
                                    paramName="sslValidateCertificate" paramType="boolean"/>
                                    <methodParameter
                                    paramName="sslValidateCertificateDate" paramType="boolean"/>
                                    <methodParameter
                                    paramName="sslTrustStore" paramType="string"/>
                                    <methodParameter
                                    paramName="sslTrustStorePassword" paramType="string"/>
                                    <methodParameter
                                    paramName="topicName" paramType="string"/>
                                    <methodParameter
                                    paramName="messageText" paramType="string"/>
                                    <methodParameter
                                    paramName="xmlPropertiesString" paramType="string"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="LogSendEnd-input" name="LogSendEnd"
                    tibex:xpdlId="20cbb241-a1c9-4236-913e-dd223563aeef" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Copy_1_JavaInvokeToCopy_1_Log"/>
                    </bpws:targets>
                    <bpws:sources/>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns15=&quot;http://tns.tibco.com/bw/json/1747129881660&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CNSTopicPrefix&quot;/>&lt;xsl:param name=&quot;ParseJSON&quot;/>&lt;xsl:template name=&quot;_LogSendEnd-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;xsl:variable name=&quot;var&quot; select=&quot;concat(substring($ParseJSON/tns15:root/tns15:flightList[1]/tns15:flightDate, 5, 4), '-', substring($ParseJSON/tns15:root/tns15:flightList[1]/tns15:flightDate, 3, 2), '-', substring($ParseJSON/tns15:root/tns15:flightList[1]/tns15:flightDate, 1, 2))&quot;/>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;JSON processed to CNS topic&amp;quot;,(concat($CNSTopicPrefix,$ParseJSON/tns15:root/tns15:flightList[1]/tns15:flightNumber,'/',$var,'/',$ParseJSON/tns15:root/tns15:flightList[1]/tns15:legList[1]/tns15:cityCode,'/',$ParseJSON/tns15:root/tns15:flightList[1]/tns15:termCityCode)))&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="QueryDB-input"
                    name="QueryDB" outputVariable="QueryDB"
                    tibex:xpdlId="01694543-6d68-4e6f-8dca-44a99c039265" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToQueryDB"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="QueryDBToLogNonDB">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($QueryDB/Record)=0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($QueryDB/Record)=0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="QueryDBToSleep">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+01694543-6d68-4e6f-8dca-44a99c039265+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentFlightKey&quot;/>&lt;xsl:template name=&quot;QueryDB-input&quot; match=&quot;/&quot;>&lt;tns6:jdbcQueryActivityInput>&lt;FlighKey>&lt;xsl:value-of select=&quot;$currentFlightKey&quot;/>&lt;/FlighKey>&lt;/tns6:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="maxRows" processProperty="MaxRows"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT &#xd;&#xa;    f.FlightNumber,&#xd;&#xa;    f.FlightDate,&#xd;&#xa;    f.Origin_CD   AS FlightOrg,&#xd;&#xa;    f.Dest_CD     AS FlightDest,&#xd;&#xa;    s.PNR,&#xd;&#xa;    STRING_AGG(CONCAT(s.SeatNum, '-', s.Passenger_Name), ', ') AS SeatPassengerList&#xd;&#xa;FROM dbo.EDA_EQCHNG_FLIGHTS f&#xd;&#xa;INNER JOIN dbo.EDA_EQCHNG_FLIGHT_SEATS s&#xd;&#xa;    ON f.FlightKey = s.FlightKey&#xd;&#xa;WHERE f.FlightKey = ?&#xd;&#xa;GROUP BY f.FlightNumber, f.FlightDate, f.Origin_CD, f.Dest_CD, s.PNR&#xd;&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FlighKey"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="FlightNumber"
                                    dataType="-9" typeName="nvarchar"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="FlightDate"
                                    dataType="-9" typeName="nvarchar"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="FlightOrg"
                                    dataType="-9" typeName="nvarchar"/>
                                    <columnMetadata columnIndex="4"
                                    columnName="FlightDest"
                                    dataType="-9" typeName="nvarchar"/>
                                    <columnMetadata columnIndex="5"
                                    columnName="PNR"
                                    dataType="-9"
                                    status="OptionalElement" typeName="nvarchar"/>
                                    <columnMetadata columnIndex="6"
                                    columnName="SeatPassengerList"
                                    dataType="-9"
                                    status="OptionalElement" typeName="nvarchar"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Sleep-input"
                    name="Sleep"
                    tibex:xpdlId="b94170a4-1e0c-4a1b-b5bb-ed206a2befa5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="QueryDBToSleep"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SleepToInvokeRESTAPI"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://tns.tibco.com/bw/activity/sleep/xsd&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SleepTime&quot;/>&lt;xsl:template name=&quot;Sleep-input&quot; match=&quot;/&quot;>&lt;tns8:SleepInputSchema>&lt;IntervalInMillisec>&lt;xsl:value-of select=&quot;xsd:integer($SleepTime)&quot;/>&lt;/IntervalInMillisec>&lt;/tns8:SleepInputSchema>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.sleep"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Sleep"/>
                                    <value xsi:type="generalactivities:Sleep"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="currentFlightKey" name="Assign"
                    outputVariable="currentFlightKey"
                    tibex:xpdlId="c4c470ba-7eed-4383-b90b-151f3eb92360" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="PublishCNSJSONToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToQueryDB"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="concat(concat($ParseJSON/ns30:root/ns30:flightList[1]/ns30:airlineCode,$ParseJSON/ns30:root/ns30:flightList[1]/ns30:flightNumber), &quot;:&quot;,$ParseJSON/ns30:root/ns30:flightList[1]/ns30:flightDate)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="currentFlightKey" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="ErrHistory-input" name="ErrHistory"
                    outputVariable="ErrHistory"
                    tibex:xpdlId="f9404ee2-145c-4bde-bf05-6232ef0295e6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ParseAPIRespToCopy_1_InsertHistory"/>
                        <bpws:target linkName="LogAPIErrorToCopy_1_InsertHistory"/>
                    </bpws:targets>
                    <bpws:sources/>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns25=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+f9404ee2-145c-4bde-bf05-6232ef0295e6+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns11=&quot;http://tns.tibco.com/bw/json/1738090578422&quot; xmlns:tns21=&quot;http://schemas.tibco.com/bw/plugins/http/5.0/httpExceptions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;currentFlightKey&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseAPIResp&quot;/>&#xa;    &lt;xsl:param name=&quot;_error_InvokeRESTAPI&quot;/>&#xa;    &lt;xsl:template name=&quot;ErrHistory-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns25:jdbcUpdateActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($ParseAPIResp/tns11:ResponseElement)=0&quot;>&#xa;                    &lt;Record>&#xa;                        &lt;FlightKey>&#xa;                            &lt;xsl:value-of select=&quot;$currentFlightKey&quot;/>&#xa;                        &lt;/FlightKey>&#xa;                        &lt;PNR>&#xa;                            &lt;xsl:value-of select=&quot;'NA'&quot;/>&#xa;                        &lt;/PNR>&#xa;                        &lt;CurrSeatNum>&#xa;                            &lt;xsl:value-of select=&quot;'NA'&quot;/>&#xa;                        &lt;/CurrSeatNum>&#xa;                        &lt;LastSeatNum>&#xa;                            &lt;xsl:value-of select=&quot;'NA'&quot;/>&#xa;                        &lt;/LastSeatNum>&#xa;                        &lt;Status>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;NoSeatsInSeatMap&amp;quot;&quot;/>&#xa;                        &lt;/Status>&#xa;                    &lt;/Record>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$_error_InvokeRESTAPI/tns21:HttpClientException/statusLine/statusCode>200&quot;>&#xa;                    &lt;Record>&#xa;                        &lt;FlightKey>&#xa;                            &lt;xsl:value-of select=&quot;$currentFlightKey&quot;/>&#xa;                        &lt;/FlightKey>&#xa;                        &lt;PNR>&#xa;                            &lt;xsl:value-of select=&quot;'NA'&quot;/>&#xa;                        &lt;/PNR>&#xa;                        &lt;CurrSeatNum>&#xa;                            &lt;xsl:value-of select=&quot;'NA'&quot;/>&#xa;                        &lt;/CurrSeatNum>&#xa;                        &lt;LastSeatNum>&#xa;                            &lt;xsl:value-of select=&quot;'NA'&quot;/>&#xa;                        &lt;/LastSeatNum>&#xa;                        &lt;Status>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;4xxReturnedBySeatMap&amp;quot;&quot;/>&#xa;                        &lt;/Status>&#xa;                    &lt;/Record>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;Record>&#xa;                        &lt;FlightKey>&#xa;                            &lt;xsl:value-of select=&quot;$currentFlightKey&quot;/>&#xa;                        &lt;/FlightKey>&#xa;                        &lt;PNR>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/PNR>&#xa;                        &lt;CurrSeatNum>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/CurrSeatNum>&#xa;                        &lt;LastSeatNum>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/LastSeatNum>&#xa;                        &lt;Status>&#xa;                            &lt;xsl:value-of select=&quot;'ErrorWhileCallingSeatMap'&quot;/>&#xa;                        &lt;/Status>&#xa;                    &lt;/Record>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns25:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value batchUpdate="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO [dbo].[EDA_EQCHNG_SEATIMPACT_HISTORY]&#xa;           ([FlightKey],[PNR]&#xa;           ,[CurrSeatNum],[LastSeatNum],[Status])&#xa;     VALUES&#xa;           (?,?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FlightKey"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="PNR"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CurrSeatNum"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="LastSeatNum"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Status"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
