                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns24=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+30a40688-5a49-453a-8d8b-dc2084098b3d+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns17=&quot;http://www.example.org/SeatsData&quot; xmlns:tns20=&quot;http://www.example.org/seatDetails&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FixIn&quot;/>&lt;xsl:param name=&quot;currentFlightKey&quot;/>&lt;xsl:param name=&quot;prcVarSeatList&quot;/>&lt;xsl:param name=&quot;TestMode&quot;/>&lt;xsl:template name=&quot;InsertHistory-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($FixIn/tns17:seatsDataElementType[tns17:isMissmatched=true()])>0 and $TestMode=true()&quot;>&lt;tns24:jdbcUpdateActivityInput>&lt;FlightKey>&lt;xsl:value-of select=&quot;$currentFlightKey&quot;/>&lt;/FlightKey>&lt;PNR>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($prcVarSeatList/tns20:PNR)&quot;>&lt;xsl:value-of select=&quot;$prcVarSeatList/tns20:PNR&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/PNR>&lt;CurrSeatNum>&lt;xsl:value-of select=&quot;tib:concat-sequence-format($FixIn/tns17:seatsDataElementType/tns17:mismatchSeat, &amp;quot;,&amp;quot;)&quot;/>&lt;/CurrSeatNum>&lt;LastSeatNum>&lt;xsl:value-of select=&quot;tib:concat-sequence-format($FixIn/tns17:seatsDataElementType/tns17:originalSeat, &amp;quot;,&amp;quot;)&quot;/>&lt;/LastSeatNum>&lt;Passenger_Name>&lt;xsl:value-of select=&quot;tib:concat-sequence-format($FixIn/tns17:seatsDataElementType/tns17:FullName, &amp;quot;,&amp;quot;)&quot;/>&lt;/Passenger_Name>&lt;Status>&lt;xsl:value-of select=&quot;&amp;quot;SentToFixer: TestMode&amp;quot;&quot;/>&lt;/Statu