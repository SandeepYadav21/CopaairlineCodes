                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns26=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+530ac67c-27b3-4774-b212-08a6dfc969d5+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns20=&quot;http://www.example.org/seatDetails&quot; xmlns:tns11=&quot;http://tns.tibco.com/bw/json/1738090578422&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentFlightKey&quot;/>&lt;xsl:param name=&quot;prcVarSeatList&quot;/>&lt;xsl:param name=&quot;ParseAPIResp&quot;/>&lt;xsl:template name=&quot;EHistory-input&quot; match=&quot;/&quot;>&lt;tns26:jdbcUpdateActivityInput>&lt;xsl:for-each select=&quot;$prcVarSeatList/tns20:SeatDetails&quot;>&lt;Record>&lt;FlightKey>&lt;xsl:value-of select=&quot;$currentFlightKey&quot;/>&lt;/FlightKey>&lt;PNR>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(../tns20:PNR)&quot;>&lt;xsl:value-of select=&quot;../tns20:PNR&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/PNR>&lt;xsl:variable name=&quot;var&quot; select=&quot;tns20:PassengerName&quot;/>&lt;CurrSeatNum>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseAPIResp/tns11:ResponseElement[tns11:passengerName=$var]/tns11:seatNumber)&quot;>&lt;xsl:value-of select=&quot;$ParseAPIResp/tns11:ResponseElement[tns11:passengerName=$var]/tns11:seatNumber&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CurrSeatNum>&lt;LastSeatNum>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns20:SeatNo)&quot;>&lt;xsl:value-of select=&quot;tns20:SeatNo&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/LastSeatNum>&lt;Status>&lt;xsl:value-of select=&quot;'ErrorInProcessing'&quot;/>&lt;/Status>&lt;/Record>&lt;/xsl:for-each>&lt;/tns26:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
