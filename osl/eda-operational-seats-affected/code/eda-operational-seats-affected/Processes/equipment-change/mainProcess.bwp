                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="cFlightDetails"
                    name="Assign" outputVariable="cFlightDetails"
                    tibex:xpdlId="817f4fe3-349e-4405-9ad7-e82a87a97b5c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ParseDataToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToJDBCQuery">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="AssignToLogJSONNonEQP">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length($cFlightDetails/ns54:FlightNumber)=0 or string-length($cFlightDetails/ns54:FlightDate)=0 or string-length($cFlightDetails/ns54:ORG_CD)=0  or string-length($cFlightDetails/ns54:DEST_CD)=0  or string-length($cFlightDetails/ns54:EQ_CD)=0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length($cFlightDetails/ns54:FlightNumber)=0 or string-length($cFlightDetails/ns54:FlightDate)=0 or string-length($cFlightDetails/ns54:ORG_CD)=0  or string-length($cFlightDetails/ns54:DEST_CD)=0  or string-length($cFlightDetails/ns54:EQ_CD)=0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns23=&quot;http://www.example.org/OSMFileInputMessage&quot; xmlns:tns29=&quot;http://www.example.org/currentFlightDetails&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseData&quot;/>&lt;xsl:template name=&quot;cFlightDetails&quot; match=&quot;/&quot;>&lt;tns29:currentFlight>&lt;xsl:variable name=&quot;varFlightNum&quot; select=&quot;substring($ParseData/Rows/tns23:InputElement[4]/tns23:Line1, 1, 5)&quot;/>&lt;xsl:variable name=&quot;varDate&quot; select=&quot;substring($ParseData/Rows/tns23:InputElement[4]/tns23:Line1,7, 7)&quot;/>&lt;xsl:variable name=&quot;varFlightDate&quot; select=&quot;concat(&amp;#xD;&amp;#xA;  substring($varDate, 1, 2), &amp;#xD;&amp;#xA;  (&amp;#xD;&amp;#xA;    if (upper-case(substring($varDate, 3, 3)) = &amp;quot;JAN&amp;quot;) then &amp;quot;01&amp;quot;&amp;#xD;&amp;#xA;    else if (upper-case(substring($varDate, 3, 3)) = &amp;quot;FEB&amp;quot;) then &amp;quot;02&amp;quot;&amp;#xD;&amp;#xA;    else if (upper-case(substring($varDate, 3, 3)) = &amp;quot;MAR&amp;quot;) then &amp;quot;03&amp;quot;&amp;#xD;&amp;#xA;    else if (upper-case(substring($varDate, 3, 3)) = &amp;quot;APR&amp;quot;) then &amp;quot;04&amp;quot;&amp;#xD;&amp;#xA;    else if (upper-case(substring($varDate, 3, 3)) = &amp;quot;MAY&amp;quot;) then &amp;quot;05&amp;quot;&amp;#xD;&amp;#xA;    else if (upper-case(substring($varDate, 3, 3)) = &amp;quot;JUN&amp;quot;) then &amp;quot;06&amp;quot;&amp;#xD;&amp;#xA;    else if (upper-case(substring($varDate, 3, 3)) = &amp;quot;JUL&amp;quot;) then &amp;quot;07&amp;quot;&amp;#xD;&amp;#xA;    else if (upper-case(substring($varDate, 3, 3)) = &amp;quot;AUG&amp;quot;) then &amp;quot;08&amp;quot;&amp;#xD;&amp;#xA;    else if (upper-case(substring($varDate, 3, 3)) = &amp;quot;SEP&amp;quot;) then &amp;quot;09&amp;quot;&amp;#xD;&amp;#xA;    else if (upper-case(substring($varDate, 3, 3)) = &amp;quot;OCT&amp;quot;) then &amp;quot;10&amp;quot;&amp;#xD;&amp;#xA;    else if (upper-case(substring($varDate, 3, 3)) = &amp;quot;NOV&amp;quot;) then &amp;quot;11&amp;quot;&amp;#xD;&amp;#xA;    else if (upper-case(substring($varDate, 3, 3)) = &amp;quot;DEC&amp;quot;) then &amp;quot;12&amp;quot;&amp;#xD;&amp;#xA;    else &amp;quot;00&amp;quot;&amp;#xD;&amp;#xA;  ),&amp;#xD;&amp;#xA;  concat(&amp;quot;20&amp;quot;, substring($varDate, 6, 2))&amp;#xD;&amp;#xA;)&quot;/>&lt;xsl:variable name=&quot;varOrgCD&quot; select=&quot;substring($ParseData/Rows/tns23:InputElement[5]/tns23:Line1,30, 3)&quot;/>&lt;xsl:variable name=&quot;varDestCD&quot; select=&quot;substring($ParseData/Rows/tns23:InputElement[5]/tns23:Line1,34, 3)&quot;/>&lt;tns29:FlightKey>&lt;xsl:value-of select=&quot;concat($varFlightNum, &amp;quot;:&amp;quot;,$varFlightDate)&quot;/>&lt;/tns29:FlightKey>&lt;tns29:FlightNumber>&lt;xsl:value-of select=&quot;$varFlightNum&quot;/>&lt;/tns29:FlightNumber>&lt;tns29:FlightDate>&lt;xsl:value-of select=&quot;$varFlightDate&quot;/>&lt;/tns29:FlightDate>&lt;tns29:ORG_CD>&lt;xsl:value-of select=&quot;$varOrgCD&quot;/>&lt;/tns29:ORG_CD>&lt;tns29:DEST_CD>&lt;xsl:value-of select=&quot;$varDestCD&quot;/>&lt;/tns29:DEST_CD>&lt;tns29:EQ_CD>&lt;xsl:value-of select=&quot;substring($ParseData/Rows/tns23:InputElement[5]/tns23:Line1, 23, 6)&quot;/>&lt;/tns29:EQ_CD>&lt;/tns29:currentFlight>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="cFlightDetails" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="JDBCQuery-input"
                    name="JDBCQuery" outputVariable="JDBCQuery"
                    tibex:xpdlId="89edb8c7-89dd-4919-82e5-027c8072cd35" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToInsert">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($JDBCQuery/Record)=0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($JDBCQuery/Record)=0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="JDBCQueryToLogJSONNonEQP">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns30=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+89edb8c7-89dd-4919-82e5-027c8072cd35+input&quot; xmlns:tns29=&quot;http://www.example.org/currentFlightDetails&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;cFlightDetails&quot;/>&lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&lt;tns30:jdbcQueryActivityInput>&lt;FlightKey>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($cFlightDetails/tns29:FlightKey)&quot;>&lt;xsl:value-of select=&quot;$cFlightDetails/tns29:FlightKey&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/FlightKey>&lt;/tns30:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select FlightKey,Curr_TAIL_CD from dbo.EDA_EQCHNG_FLIGHTS where FlightKey=?&#xa;"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FlightKey"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="FlightKey"
                                    dataType="-9" typeName="nvarchar"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="Curr_TAIL_CD"
                                    dataType="-9" typeName="nvarchar"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Insert-input"
                    name="Insert" outputVariable="Insert"
                    tibex:xpdlId="b70a1337-763e-4479-b345-e5429fcd0ba6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToInsert"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="InsertTogetSeats"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns35=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b70a1337-763e-4479-b345-e5429fcd0ba6+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns29=&quot;http://www.example.org/currentFlightDetails&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;cFlightDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;Insert-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns35:jdbcUpdateActivityInput>&#xa;            &lt;FlightKey>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($cFlightDetails/tns29:FlightKey)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$cFlightDetails/tns29:FlightKey&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/FlightKey>&#xa;            &lt;FlightNumber>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($cFlightDetails/tns29:FlightNumber)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$cFlightDetails/tns29:FlightNumber&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/FlightNumber>&#xa;            &lt;FlightDate>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($cFlightDetails/tns29:FlightDate)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$cFlightDetails/tns29:FlightDate&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/FlightDate>&#xa;            &lt;Origin_CD>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($cFlightDetails/tns29:ORG_CD)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$cFlightDetails/tns29:ORG_CD&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/Origin_CD>&#xa;            &lt;Dest_CD>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($cFlightDetails/tns29:DEST_CD)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$cFlightDetails/tns29:DEST_CD&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/Dest_CD>&#xa;            &lt;Curr_TAIL_CD>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($cFlightDetails/tns29:EQ_CD)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$cFlightDetails/tns29:EQ_CD&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/Curr_TAIL_CD>&#xa;        &lt;/tns35:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
