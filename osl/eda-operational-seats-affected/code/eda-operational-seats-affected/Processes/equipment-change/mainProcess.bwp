                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns35=&quot;http://www.tibco.com/namespaces/tnt/plugins/restinvoke+e6b45211-91ea-44fb-8375-f57b17e3bfe9+RestInvokeInput&quot; xmlns:tns23=&quot;http://www.example.org/OSMFileInputMessage&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;URI&quot;/>&#xa;    &lt;xsl:param name=&quot;APIM_KEY&quot;/>&#xa;    &lt;xsl:param name=&quot;APIM_CHANNEL&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseData&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeRESTAPI-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns35:RestActivityInput>&#xa;            &lt;ResourcePath>&#xa;                &lt;xsl:value-of select=&quot;concat($URI,'/',substring($ParseData/Rows/tns23:InputElement[4]/tns23:Line1, 3, 3),'/',format-dateTime(tib:parse-dateTime(&amp;quot;ddMMMyy&amp;quot;,substring($ParseData/Rows/tns23:InputElement[4]/tns23:Line1,7,7)), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;            &lt;/ResourcePath>&#xa;            &lt;HttpHeaders>&#xa;                &lt;DynamicHeaders>&#xa;                    &lt;Header>&#xa;                        &lt;Name>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Ocp-Apim-Subscription-Key&amp;quot;&quot;/>&#xa;                        &lt;/Name>&#xa;                        &lt;Value>&#xa;                            &lt;xsl:value-of select=&quot;$APIM_KEY&quot;/>&#xa;                        &lt;/Value>&#xa;                    &lt;/Header>&#xa;                    &lt;Header>&#xa;                        &lt;Name>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Copa-Channel-ID&amp;quot;&quot;/>&#xa;                        &lt;/Name>&#xa;                        &lt;Value>&#xa;                            &lt;xsl:value-of select=&quot;$APIM_CHANNEL&quot;/>&#xa;                        &lt;/Value>&#xa;                    &lt;/Header>&#xa;                &lt;/DynamicHeaders>&#xa;            &lt;/HttpHeaders>&#xa;        &lt;/tns35:RestActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
