                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns35=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+20694756-31e3-4f49-ba8d-bf7f7cd38782+input&quot; xmlns:tns29=&quot;http://www.example.org/currentFlightDetails&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;cFlightDetails&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns35:jdbcUpdateActivityInput>&#xa;            &lt;LastUpdatedDateTime>&#xa;                &lt;xsl:value-of select=&quot;tib:translate-timezone(current-dateTime(),&amp;quot;America/Panama&amp;quot;)&quot;/>&#xa;            &lt;/LastUpdatedDateTime>&#xa;            &lt;Curr_TAIL_CD>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($cFlightDetails/tns29:EQ_CD)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$cFlightDetails/tns29:EQ_CD&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/Curr_TAIL_CD>&#xa;            &lt;Last_TAIL_CD>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($JDBCQuery/Record[1]/Curr_TAIL_CD)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/Curr_TAIL_CD&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/Last_TAIL_CD>&#xa;            &lt;FlightKey>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($cFlightDetails/tns29:FlightKey)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$cFlightDetails/tns29:FlightKey&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/FlightKey>&#xa;        &lt;/tns35:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
