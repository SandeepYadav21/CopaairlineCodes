                                    expression="contains($ParseData/Rows/tns:InputElement[1]/tns:Line1,'ASM') and contains($ParseData/Rows/tns:InputElement[3]/tns:Line1,'EQT') and contains($ParseData/Rows/tns:InputElement[5]/tns:Line1,'.') and contains($ParseData/Rows/tns:InputElement[4]/tns:Line1,'CM')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[contains($ParseData/Rows/tns:InputElement[1]/tns:Line1,'ASM') and contains($ParseData/Rows/tns:InputElement[3]/tns:Line1,'EQT') and contains($ParseData/Rows/tns:InputElement[5]/tns:Line1,'.') and contains($ParseData/Rows/tns:InputElement[4]/tns:Line1,'CM')]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="ParseDataToCopy_1_LogJSON1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
