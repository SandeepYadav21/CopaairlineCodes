                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns35=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+83739c33-0951-47bf-9c27-1dcf4e7f75b6+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns29=&quot;http://www.example.org/currentFlightDetails&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;cFlightDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;DelSeat-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns35:jdbcUpdateActivityInput>&#xa;            &lt;FlightKey>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($cFlightDetails/tns29:FlightKey)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$cFlightDetails/tns29:FlightKey&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/FlightKey>&#xa;        &lt;/tns35:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="Delete from [dbo].EDA_EQCHNG_FLIGHT_SEATS where FlightKey=?"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FlightKey"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="ParseAPIJSON-input"
                    name="ParseAPIJSON" outputVariable="ParseAPIJSON"
                    tibex:xpdlId="b64a02e4-6a27-4d58-9185-87248058d5a6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="getSeatsToParseAPIJSON"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ParseAPIJSONToDelSeat_Update">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($JDBCQuery/Record)>0 and  $JDBCQuery/Record[1]/Curr_TAIL_CD!=$cFlightDetails/ns54:EQ_CD" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($JDBCQuery/Record)>0 and  $JDBCQuery/Record[1]/Curr_TAIL_CD!=$cFlightDetails/ns54:EQ_CD]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="ParseAPIJSONToRenderJSON">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns31=&quot;activity.jsonParser.input+b64a02e4-6a27-4d58-9185-87248058d5a6+ActivityInputType&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;getSeats&quot;/>&lt;xsl:template name=&quot;ParseAPIJSON-input&quot; match=&quot;/&quot;>&lt;tns31:ActivityInputClass>&lt;jsonString>&lt;xsl:value-of select=&quot;$getSeats/MessageBody/asciiContent&quot;/>&lt;/jsonString>&lt;/tns31:ActivityInputClass>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.restjson.JsonParser"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:restjson="http://ns.tibco.com/bw/palette/restjson" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/restjson#//JsonParser"/>
                                    <value jsonInputStyle="None"
                                    schemaType="Xsd" xsi:type="restjson:JsonParser">
                                    <outputEditorElement href="platform:/resource/eda-operational-seats-affected/Schemas/APIResponseResource.xsd#//APIResponseElement;XSDElementDeclaration"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="RenderJSON-input" name="RenderJSON"
                    outputVariable="RenderJSON"
                    tibex:xpdlId="8c60636a-268b-470c-bae7-14f0451acf70" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="DelSeatToRenderJSON"/>
                        <bpws:target linkName="ParseAPIJSONToRenderJSON"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RenderJSONToInsertSeat"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns29=&quot;http://www.example.org/currentFlightDetails&quot; xmlns:tns35=&quot;http://www.example.org/EqChnageFlightDetails&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;cFlightDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;RenderJSON-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns35:FlightDetail>&#xa;            &lt;xsl:if test=&quot;$cFlightDetails/tns29:FlightNumber&quot;>&#xa;                &lt;tns35:FlightNumber>&#xa;                    &lt;xsl:value-of select=&quot;$cFlightDetails/tns29:FlightNumber&quot;/>&#xa;                &lt;/tns35:FlightNumber>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$cFlightDetails/tns29:FlightDate&quot;>&#xa;                &lt;tns35:FlightDate>&#xa;                    &lt;xsl:value-of select=&quot;$cFlightDetails/tns29:FlightDate&quot;/>&#xa;                &lt;/tns35:FlightDate>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$cFlightDetails/tns29:ORG_CD&quot;>&#xa;                &lt;tns35:ORG_CD>&#xa;                    &lt;xsl:value-of select=&quot;$cFlightDetails/tns29:ORG_CD&quot;/>&#xa;                &lt;/tns35:ORG_CD>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$cFlightDetails/tns29:DEST_CD&quot;>&#xa;                &lt;tns35:DEST_CD>&#xa;                    &lt;xsl:value-of select=&quot;$cFlightDetails/tns29:DEST_CD&quot;/>&#xa;                &lt;/tns35:DEST_CD>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$cFlightDetails/tns29:EQ_CD&quot;>&#xa;                &lt;tns35:EQ_CD>&#xa;                    &lt;xsl:value-of select=&quot;$cFlightDetails/tns29:EQ_CD&quot;/>&#xa;                &lt;/tns35:EQ_CD>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns35:CurrentTimeStamp>&#xa;                &lt;xsl:value-of select=&quot;tib:timestamp()&quot;/>&#xa;            &lt;/tns35:CurrentTimeStamp>&#xa;        &lt;/tns35:FlightDetail>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.restjson.JsonRender"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:restjson="http://ns.tibco.com/bw/palette/restjson" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/restjson#//JsonRender"/>
                                    <value jsonOutputStyle="None"
                                    schemaType="Xsd" xsi:type="restjson:JsonRender">
                                    <inputEditorElement href="platform:/resource/eda-operational-seats-affected/Schemas/nv1/EqChnageFlightDetails.xsd#//FlightDetail;XSDElementDeclaration"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Publish-input"
                    name="Publish" outputVariable="Publish"
                    tibex:xpdlId="8084d166-f5d7-4e5d-ac94-67042fa19d4b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InsertSeatToPublishCNSJSON"/>
                    </bpws:targets>
                    <bpws:sources/>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns34=&quot;www.tibco.com/plugin/java/JavaInvokeActivityInput+8084d166-f5d7-4e5d-ac94-67042fa19d4b+JavaInvokeActivityInput&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RenderJSON&quot;/>&#xa;    &lt;xsl:template name=&quot;Publish-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns34:JavaInvokeActivityInput>&#xa;            &lt;MethodParameters>&#xa;                &lt;host>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;//eda-common-module///Connection/Solace/Host&amp;quot;)&quot;/>&#xa;                &lt;/host>&#xa;                &lt;username>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;//eda-common-module///Connection/Solace/Username&amp;quot;)&quot;/>&#xa;                &lt;/username>&#xa;                &lt;password>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;//eda-common-module///Connection/Solace/Password&amp;quot;)&quot;/>&#xa;                &lt;/password>&#xa;                &lt;vpnName>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;//eda-common-module///Connection/Solace/vpnName&amp;quot;)&quot;/>&#xa;                &lt;/vpnName>&#xa;                &lt;sslValidateCertificate>&#xa;                    &lt;xsl:value-of select=&quot;xsd:boolean(bw:getModuleProperty(&amp;quot;//eda-common-module///Connection/Solace/sslValidateCertificate&amp;quot;))&quot;/>&#xa;                &lt;/sslValidateCertificate>&#xa;                &lt;sslValidateCertificateDate>&#xa;                    &lt;xsl:value-of select=&quot;xsd:boolean(bw:getModuleProperty(&amp;quot;//eda-common-module///Connection/Solace/sslValidateCertificateDate&amp;quot;))&quot;/>&#xa;                &lt;/sslValidateCertificateDate>&#xa;                &lt;sslTrustStore>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;//eda-common-module///Connection/Solace/sslTrustStore&amp;quot;)&quot;/>&#xa;                &lt;/sslTrustStore>&#xa;                &lt;sslTrustStorePassword>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;//eda-common-module///Connection/Solace/sslTrustStorePassword&amp;quot;)&quot;/>&#xa;                &lt;/sslTrustStorePassword>&#xa;                &lt;inputMessage>&#xa;                    &lt;xsl:value-of select=&quot;$RenderJSON/jsonString&quot;/>&#xa;                &lt;/inputMessage>&#xa;                &lt;topicName>&#xa;                    &lt;xsl:value-of select=&quot;$EqPublishTopic&quot;/>&#xa;                &lt;/topicName>&#xa;            &lt;/MethodParameters>&#xa;        &lt;/tns34:JavaInvokeActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.java.javamethod"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:java="http://ns.tibco.com/bw/palette/java" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/java#//JavaMethod"/>
                                    <value
                                    className="solaceJava.SolacePublisher"
                                    isNew="true"
                                    isNewActivity="true"
                                    isStaticMethod="true"
                                    methodName="sendMessageToSolace"
                                    methodReturn="string" xsi:type="java:JavaMethod">
                                    <exceptionTypes>com.solacesystems.jcsmp.JCSMPException</exceptionTypes>
                                    <methodParameter
                                    paramName="host" paramType="string"/>
                                    <methodParameter
                                    paramName="username" paramType="string"/>
                                    <methodParameter
                                    paramName="password" paramType="string"/>
                                    <methodParameter
                                    paramName="vpnName" paramType="string"/>
                                    <methodParameter
                                    paramName="sslValidateCertificate" paramType="boolean"/>
                                    <methodParameter
                                    paramName="sslValidateCertificateDate" paramType="boolean"/>
                                    <methodParameter
                                    paramName="sslTrustStore" paramType="string"/>
                                    <methodParameter
                                    paramName="sslTrustStorePassword" paramType="string"/>
                                    <methodParameter
                                    paramName="inputMessage" paramType="string"/>
                                    <methodParameter
                                    paramName="topicName" paramType="string"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
