                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns32=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9ad6d4c1-f9f5-4355-8c96-6e0bcb422cec+input&quot; xmlns:tns12=&quot;http://tns.tibco.com/bw/json/1738090578422&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns29=&quot;http://www.example.org/currentFlightDetails&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;cFlightDetails&quot;/>&lt;xsl:param name=&quot;ParseAPIJSON&quot;/>&lt;xsl:template name=&quot;InsertSeat-input&quot; match=&quot;/&quot;>&lt;tns32:jdbcUpdateActivityInput>&lt;xsl:for-each select=&quot;$ParseAPIJSON/tns12:ResponseElement&quot;>&lt;Record>&lt;SeatNum>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns12:seatNumber)&quot;>&lt;xsl:value-of select=&quot;tns12:seatNumber&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/SeatNum>&lt;FlightKey>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($cFlightDetails/tns29:FlightKey)&quot;>&lt;xsl:value-of select=&quot;$cFlightDetails/tns29:FlightKey&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/FlightKey>&lt;PNR>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns12:pnr)&quot;>&lt;xsl:value-of select=&quot;tns12:pnr&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/PNR>&lt;Passenger_Name>&lt;xsl:value-of select=&quot;upper-case(tns12:passengerName)&quot;/>&lt;/Passenger_Name>&lt;UpdatedBy_EQP_CD>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($cFlightDetails/tns29:EQ_CD)&quot;>&lt;xsl:value-of select=&quot;$cFlightDetails/tns29:EQ_CD&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/UpdatedBy_EQP_CD>&lt;/Record>&lt;/xsl:for-each>&lt;/tns32:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
