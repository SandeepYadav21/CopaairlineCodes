            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="LogJSONNonEQP-input"
                    name="LogJSONNonEQP"
                    tibex:xpdlId="32454a63-c45d-413f-9290-f8f0996768db" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ParseDataToCopy_1_LogJSON1"/>
                        <bpws:target linkName="AssignToLogJSONNonEQP"/>
                        <bpws:target linkName="JDBCQueryToLogJSONNonEQP"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogJSONNonEQPToUpdateTail">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($JDBCQuery/Record)>0 and  $JDBCQuery/Record[1]/Curr_TAIL_CD!=$cFlightDetails/ns54:EQ_CD" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($JDBCQuery/Record)>0 and  $JDBCQuery/Record[1]/Curr_TAIL_CD!=$cFlightDetails/ns54:EQ_CD]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns29=&quot;http://www.example.org/currentFlightDetails&quot; xmlns:tns22=&quot;http://tns.tibco.com/bw/json/1744010364512&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;cFlightDetails&quot;/>&lt;xsl:param name=&quot;ParseJSON&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;LogJSONNonEQP-input&quot; match=&quot;/&quot;>&lt;tns1:ActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;count($JDBCQuery/Record)>0 and  $JDBCQuery/Record[1]/Curr_TAIL_CD!=$cFlightDetails/tns29:EQ_CD&quot;>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot; ##TailChanged for FlighKey:&amp;quot;,$cFlightDetails/tns29:FlightKey,&amp;quot; Existing Tail_CD:&amp;quot;,$JDBCQuery/Record[1]/Curr_TAIL_CD,&amp;quot; New Tail_CD:&amp;quot;,$cFlightDetails/tns29:EQ_CD)&quot;/>&lt;/message>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($cFlightDetails/tns29:FlightNumber)=0 or string-length($cFlightDetails/tns29:FlightDate)=0 or string-length($cFlightDetails/tns29:ORG_CD)=0  or string-length($cFlightDetails/tns29:DEST_CD)=0  or string-length($cFlightDetails/tns29:EQ_CD)=0&quot;>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;####Rejecting Request##### Required Details Missing in the received request : &amp;quot;,$ParseJSON/tns22:Content)&quot;/>&lt;/message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;message>&lt;xsl:value-of select=&quot;&amp;quot;####Rejecting Request##### No Equipment change or Non COPA Flight &amp;quot;&quot;/>&lt;/message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns1:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
