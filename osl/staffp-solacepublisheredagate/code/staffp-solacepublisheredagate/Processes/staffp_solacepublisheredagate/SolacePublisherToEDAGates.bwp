                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tibco.com/plugin/java/JavaInvokeActivityInput+be4928c4-ab59-4119-9517-db3c592d70cb+JavaInvokeActivityInput&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.example.org/FlightGates&quot; xmlns:tns4=&quot;http://www.example.org/KeyVaultSchema&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MsgGatesDetails&quot;/>&lt;xsl:param name=&quot;ParseJSON&quot;/>&lt;xsl:param name=&quot;Environment&quot;/>&lt;xsl:param name=&quot;SolacePathAuth&quot;/>&lt;xsl:param name=&quot;Keyvault&quot;/>&lt;xsl:template name=&quot;SendToSolace-input&quot; match=&quot;/&quot;>&lt;tns:JavaInvokeActivityInput>&lt;MethodParameters>&lt;xsl:variable name=&quot;FlightNumber&quot; select=&quot;substring($ParseJSON/tns3:eventIdentifier/tns3:flightID, 2)&quot;/>&lt;xsl:variable name=&quot;AcOwner&quot; select=&quot;substring($ParseJSON/tns3:eventIdentifier/tns3:flightID, 0,2)&quot;/>&lt;host>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;/Solace/URl&amp;quot;)&quot;/>&lt;/host>&lt;username>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;/Solace/UserName&amp;quot;)&quot;/>&lt;/username>&lt;xsl:choose>&lt;xsl:when test=&quot;$SolacePathAuth/tns4:Secret/tns4:Name='SolacePassword'&quot;>&lt;password>&lt;xsl:value-of select=&quot;$SolacePathAuth/tns4:Secret[lower-case(tns4:Name)=lower-case(substring-after($Keyvault,'/'))]/tns4:Value&quot;/>&lt;/password>&lt;/xsl:when>&lt;/xsl:choose>&lt;vpnName>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;/Solace/vpnName&amp;quot;)&quot;/>&lt;/vpnName>&lt;sslValidateCertificate>&lt;xsl:value-of select=&quot;xsd:boolean(bw:getModuleProperty(&amp;quot;/Solace/sslValidateCertificate&amp;quot;))&quot;/>&lt;/sslValidateCertificate>&lt;sslValidateCertificateDate>&lt;xsl:value-of select=&quot;xsd:boolean(bw:getModuleProperty(&amp;quot;/Solace/sslValidateCertificateDate&amp;quot;))&quot;/>&lt;/sslValidateCertificateDate>&lt;sslTrustStore>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;/Solace/sslTrustStore&amp;quot;)&quot;/>&lt;/sslTrustStore>&lt;xsl:choose>&lt;xsl:when test=&quot;$SolacePathAuth/tns4:Secret/tns4:Name='SolacesslTrustStorePassword'&quot;>&lt;sslTrustStorePassword>&lt;xsl:value-of select=&quot;$SolacePathAuth/tns4:Secret[lower-case(tns4:Name)=lower-case(substring-after($Keyvault,'/'))]/tns4:Value&quot;/>&lt;/sslTrustStorePassword>&lt;/xsl:when>&lt;/xsl:choose>&lt;inputMessage>&lt;xsl:value-of select=&quot;$MsgGatesDetails/Body&quot;/>&lt;/inputMessage>&lt;topicName>&lt;xsl:value-of select=&quot;replace($ParseJSON/tns3:topic,&amp;quot;dev&amp;quot;,$Environment)&quot;/>&lt;/topicName>&lt;/MethodParameters>&lt;/tns:JavaInvokeActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.java.javamethod"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:java="http://ns.tibco.com/bw/palette/java" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/java#//JavaMethod"/>
                                    <value className="SolacePublisher"
                                    isNew="true"
                                    isNewActivity="true"
                                    isStaticMethod="true"
                                    methodName="sendMessageToSolace"
                                    methodReturn="string" xsi:type="java:JavaMethod">
                                    <exceptionTypes>com.solacesystems.jcsmp.JCSMPException</exceptionTypes>
                                    <methodParameter
                                    paramName="host" paramType="string"/>
