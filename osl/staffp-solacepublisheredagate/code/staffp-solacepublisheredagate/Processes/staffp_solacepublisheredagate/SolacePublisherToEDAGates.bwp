            <bpws:extensionActivity>
                <tibex:extActivity name="SolacePathAuth"
                    outputVariable="SolacePathAuth"
                    tibex:xpdlId="ed52c53d-a2fb-4e89-9e0e-dcddfe54c86e"
                    type="bw.internal.getSharedVariable" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ParseJSONToGetSharedVariable"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GetSharedVariableToSendMessageToSolace">
                            <tibex:DesignExpression>
                                <tibex:expression expression="1=2" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[1=2]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="SolacePathAuthToCopy_1_SendToSolace">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:GetSharedVariable inline="true"
                        variableName="AzSecret" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="SendToSolace-input"
                    name="SendToSolace" outputVariable="SendToSolace"
                    tibex:xpdlId="5b01a23d-cf34-42bb-8db7-aedd286cd492" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SolacePathAuthToCopy_1_SendToSolace"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Copy_1_SendToSolaceToEndLog"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;www.tibco.com/plugin/java/JavaInvokeActivityInput+5b01a23d-cf34-42bb-8db7-aedd286cd492+JavaInvokeActivityInput&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.example.org/FlightGates&quot; xmlns:tns4=&quot;http://www.example.org/KeyVaultSchema&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MsgGatesDetails&quot;/>&lt;xsl:param name=&quot;ParseJSON&quot;/>&lt;xsl:param name=&quot;Environment&quot;/>&lt;xsl:param name=&quot;SolacePass&quot;/>&lt;xsl:param name=&quot;SolaceCertPass&quot;/>&lt;xsl:template name=&quot;SendToSolace-input&quot; match=&quot;/&quot;>&lt;tns5:JavaInvokeActivityInput>&lt;MethodParameters>&lt;xsl:variable name=&quot;FlightNumber&quot; select=&quot;substring($ParseJSON/tns3:eventIdentifier/tns3:flightID, 2)&quot;/>&lt;xsl:variable name=&quot;AcOwner&quot; select=&quot;substring($ParseJSON/tns3:eventIdentifier/tns3:flightID, 0,2)&quot;/>&lt;host>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;/Solace/URl&amp;quot;)&quot;/>&lt;/host>&lt;username>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;/Solace/UserName&amp;quot;)&quot;/>&lt;/username>&lt;password>&lt;xsl:value-of select=&quot;$SolacePass&quot;/>&lt;/password>&lt;vpnName>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;/Solace/vpnName&amp;quot;)&quot;/>&lt;/vpnName>&lt;sslValidateCertificate>&lt;xsl:value-of select=&quot;xsd:boolean(bw:getModuleProperty(&amp;quot;/Solace/sslValidateCertificate&amp;quot;))&quot;/>&lt;/sslValidateCertificate>&lt;sslValidateCertificateDate>&lt;xsl:value-of select=&quot;xsd:boolean(bw:getModuleProperty(&amp;quot;/Solace/sslValidateCertificateDate&amp;quot;))&quot;/>&lt;/sslValidateCertificateDate>&lt;sslTrustStore>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;/Solace/sslTrustStore&amp;quot;)&quot;/>&lt;/sslTrustStore>&lt;sslTrustStorePassword>&lt;xsl:value-of select=&quot;$SolaceCertPass&quot;/>&lt;/sslTrustStorePassword>&lt;inputMessage>&lt;xsl:value-of select=&quot;$MsgGatesDetails/Body&quot;/>&lt;/inputMessage>&lt;topicName>&lt;xsl:value-of select=&quot;replace($ParseJSON/tns3:topic,&amp;quot;dev&amp;quot;,$Environment)&quot;/>&lt;/topicName>&lt;/MethodParameters>&lt;/tns5:JavaInvokeActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.java.javamethod"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:java="http://ns.tibco.com/bw/palette/java" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/java#//JavaMethod"/>
                                    <value className="SolacePublisher"
                                    isNew="true"
                                    isNewActivity="true"
                                    isStaticMethod="true"
                                    methodName="sendMessageToSolace"
                                    methodReturn="string" xsi:type="java:JavaMethod">
                                    <exceptionTypes>com.solacesystems.jcsmp.JCSMPException</exceptionTypes>
                                    <methodParameter
                                    paramName="host" paramType="string"/>
                                    <methodParameter
                                    paramName="username" paramType="string"/>
                                    <methodParameter
                                    paramName="password" paramType="string"/>
                                    <methodParameter
                                    paramName="vpnName" paramType="string"/>
                                    <methodParameter
                                    paramName="sslValidateCertificate" paramType="boolean"/>
                                    <methodParameter
                                    paramName="sslValidateCertificateDate" paramType="boolean"/>
                                    <methodParameter
                                    paramName="sslTrustStore" paramType="string"/>
                                    <methodParameter
                                    paramName="sslTrustStorePassword" paramType="string"/>
                                    <methodParameter
                                    paramName="inputMessage" paramType="string"/>
                                    <methodParameter
                                    paramName="topicName" paramType="string"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
