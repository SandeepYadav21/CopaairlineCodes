<?xml version="1.0" encoding="UTF-8"?>
<bpws:process exitOnStandardFault="no" name="SubProcess.GetKeyVault"
    suppressJoinFailure="yes"
    targetNamespace="http://xmlns.example.com/20251111142305"
    xmlns:bpws="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
    xmlns:info="http://www.tibco.com/bw/process/info"
    xmlns:ns="http://www.tibco.com/pe/EngineTypes"
    xmlns:ns0="http://www.tibco.com/namespaces/tnt/plugins/restinvoke+fb2d0cf6-a993-42e6-b77e-a90a0021401c+RestInvokeInput"
    xmlns:ns1="http://www.tibco.com/namespaces/tnt/plugins/restinvoke+fb2d0cf6-a993-42e6-b77e-a90a0021401c+RestInvokeOutput"
    xmlns:ns10="http://tns.tibco.com/bw/json/16884937408791"
    xmlns:ns11="http://tns.tibco.com/bw/palette/internal/accumulateoutput+10b521da-123a-43dc-bd86-3b133bdf2639"
