    xmlns:ns3="activity.jsonParser.input+f5b6e464-dba9-42f8-9f42-c3545a712466+ActivityInputType"
    xmlns:ns4="http://tns.tibco.com/bw/json/16884928726781"
    xmlns:ns5="http://tns.tibco.com/bw/palette/internal/activityerror+bw.restjson.JsonParser"
    xmlns:ns6="http://www.tibco.com/pe/WriteToLogActivitySchema"
    xmlns:ns7="http://www.tibco.com/namespaces/tnt/plugins/restinvoke+4cb30b16-382d-4643-92f7-4212837445b0+RestInvokeInput"
    xmlns:ns8="http://www.tibco.com/namespaces/tnt/plugins/restinvoke+4cb30b16-382d-4643-92f7-4212837445b0+RestInvokeOutput"
    xmlns:ns9="activity.jsonParser.input+adcc9d7d-991b-4369-806a-d83d6bb11e45+ActivityInputType"
    xmlns:sca="http://docs.oasis-open.org/ns/opencsa/sca/200912"
    xmlns:sca-bpel="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"
    xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"
    xmlns:tibprop="http://ns.tibco.com/bw/property"
    xmlns:tns="http://www.example.org/KeyVaultSchema" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <tibex:VariableDescriptor type="MemorySaving">
        <task name="SecretPath">
            <endingVariables>
                <variable>SecretPath-input</variable>
                <variable>SecretPassAuth</variable>
                <variable>SecretkeystoreAuth</variable>
            </endingVariables>
        </task>
        <task name="GetAzToken">
            <endingVariables>
                <variable>GetAzToken-input</variable>
                <variable>AgentPoolClientId</variable>
                <variable>azToken-ApiVersion</variable>
            </endingVariables>
        </task>
        <task name="ParseAzToken">
            <endingVariables>
                <variable>ParseAzToken-input</variable>
                <variable>GetAzToken</variable>
            </endingVariables>
        </task>
        <task name="AzTokenLog">
            <endingVariables>
                <variable>AzTokenLog-input</variable>
            </endingVariables>
        </task>
        <task name="SetSharedVariable">
            <endingVariables>
                <variable>SetSharedVariable-input</variable>
                <variable>SetSharedVariable</variable>
                <variable>Accumulate</variable>
            </endingVariables>
        </task>
        <task name="Iterate">
            <endingVariables>
                <variable>SecretPath</variable>
                <variable>ParseAzToken</variable>
                <variable>azSecret-ApiVersion</variable>
                <variable>AccAzSecret</variable>
                <variable>currentElement</variable>
            </endingVariables>
        </task>
        <task name="GetAzSecret">
            <endingVariables>
                <variable>GetAzSecret-input</variable>
            </endingVariables>
        </task>
        <task name="ParseAzSecret">
            <endingVariables>
                <variable>ParseAzSecret-input</variable>
                <variable>GetAzSecret</variable>
            </endingVariables>
        </task>
        <task name="AzSecretLog">
            <endingVariables>
                <variable>AzSecretLog-input</variable>
            </endingVariables>
        </task>
        <task name="AccAzSecret">
            <endingVariables>
                <variable>AccAzSecret-input</variable>
                <variable>ParseAzSecret</variable>
            </endingVariables>
        </task>
        <task name="ExceptionLog">
            <endingVariables>
                <variable>ExceptionLog-input</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
