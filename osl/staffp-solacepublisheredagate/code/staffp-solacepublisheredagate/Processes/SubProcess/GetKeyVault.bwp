                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="AccAzSecret-input"
                                    name="AccAzSecret"
                                    outputVariable="AccAzSecret"
                                    tibex:xpdlId="8c06c5a4-d09f-460f-9b23-5a2b48c3c5c8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Log1ToMapper1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Mapper1ToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/KeyVaultSchema&quot; xmlns:tns6=&quot;http://tns.tibco.com/bw/json/16884937408791&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseAzSecret&quot;/>&#xa;    &lt;xsl:template name=&quot;AccAzSecret-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:AzSecret>&#xa;            &lt;tns1:Secret>&#xa;                &lt;tns1:Name>&#xa;                    &lt;xsl:value-of select=&quot;tib:trim(substring-after($currentElement, &amp;quot;secrets/&amp;quot;))&quot;/>&#xa;                &lt;/tns1:Name>&#xa;                &lt;tns1:Value>&#xa;                    &lt;xsl:value-of select=&quot;tib:trim($ParseAzSecret/tns6:value)&quot;/>&#xa;                &lt;/tns1:Value>&#xa;            &lt;/tns1:Secret>&#xa;        &lt;/tns1:AzSecret>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
