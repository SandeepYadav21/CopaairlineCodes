                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tibco.com/plugin/java/JavaInvokeActivityInput+4e85d30d-a143-4080-a85f-c1d6a26b6d05+JavaInvokeActivityInput&quot; xmlns:tns4=&quot;http://www.example.org/EDAOooitimes&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tns3=&quot;http://www.example.org/KeyVaultSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;ParseJSON&quot;/>&lt;xsl:param name=&quot;Environment&quot;/>&lt;xsl:param name=&quot;SolacePathAuth&quot;/>&lt;xsl:template name=&quot;JavaInvoke-input&quot; match=&quot;/&quot;>&lt;tns:JavaInvokeActivityInput>&lt;MethodParameters>&lt;host>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;/Solace/URl&amp;quot;)&quot;/>&lt;/host>&lt;username>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;/Solace/UserName&amp;quot;)&quot;/>&lt;/username>&lt;xsl:choose>&lt;xsl:when test=&quot;$SolacePathAuth/tns3:Secret/tns3:Name='SolacePassword'&quot;>&lt;password>&lt;xsl:value-of select=&quot;$SolacePathAuth/tns3:Secret[lower-case(tns3:Name)=lower-case(substring-after($Keyvault,'/'))]/tns3:Value&quot;/>&lt;/password>&lt;/xsl:when>&lt;/xsl:choose>&lt;vpnName>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;/Solace/vpnName&amp;quot;)&quot;/>&lt;/vpnName>&lt;sslValidateCertificate>&lt;xsl:value-of select=&quot;xsd:boolean(bw:getModuleProperty(&amp;quot;/Solace/sslValidateCertificate&amp;quot;))&quot;/>&lt;/sslValidateCertificate>&lt;sslValidateCertificateDate>&lt;xsl:value-of select=&quot;xsd:boolean(bw:getModuleProperty(&amp;quot;/Solace/sslValidateCertificateDate&amp;quot;))&quot;/>&lt;/sslValidateCertificateDate>&lt;sslTrustStore>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;/Solace/sslTrustStore&amp;quot;)&quot;/>&lt;/sslTrustStore>&lt;xsl:choose>&lt;xsl:when test=&quot;$SolacePathAuth/tns3:Secret/tns3:Name='SolacesslTrustStorePassword'&quot;>&lt;sslTrustStorePassword>&lt;xsl:value-of select=&quot;$SolacePathAuth/tns3:Secret[lower-case(tns3:Name)=lower-case(substring-after($Keyvault,'/'))]/tns3:Value&quot;/>&lt;/sslTrustStorePassword>&lt;/xsl:when>&lt;/xsl:choose>&lt;inputMessage>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body&quot;/>&lt;/inputMessage>&lt;topicName>&lt;xsl:value-of select=&quot;replace($ParseJSON/tns4:topic,&amp;quot;dev&amp;quot;,$Environment)&quot;/>&lt;/topicName>&lt;/MethodParameters>&lt;/tns:JavaInvokeActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.java.javamethod"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
