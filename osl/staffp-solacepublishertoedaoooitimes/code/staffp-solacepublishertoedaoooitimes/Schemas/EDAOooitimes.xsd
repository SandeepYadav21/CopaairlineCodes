<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/EDAOooitimes" xmlns:tns="http://www.example.org/EDAOooitimes" elementFormDefault="qualified">


     <complexType name="EDAOooitimesSchemaType">
    <sequence>
      <element maxOccurs="1" minOccurs="0" name="id" type="string"/>
      <element maxOccurs="1" minOccurs="0" name="eventTime" type="string"/>
      <element maxOccurs="1" minOccurs="0" name="dataVersion" type="string"/>
      <element maxOccurs="1" minOccurs="0" name="eventType" type="string"/>
      <element maxOccurs="1" minOccurs="0" name="topic" type="string"/>
      <element maxOccurs="1" minOccurs="0" name="eventIdentifier">
        <complexType>
          <sequence>
            <element maxOccurs="1" minOccurs="0" name="flightID" type="string"/>
            <element maxOccurs="1" minOccurs="0" name="flightDate" type="string"/>
            <element maxOccurs="1" minOccurs="0" name="departure" type="string"/>
            <element maxOccurs="1" minOccurs="0" name="arrival" type="string"/>
          </sequence>
        </complexType>
      </element>
      <element maxOccurs="1" minOccurs="0" name="data">
        <complexType>
          <sequence>
            <element maxOccurs="unbounded" minOccurs="0" name="OOOiTimes">
              <complexType>
                <sequence>
                  <element maxOccurs="1" minOccurs="0" name="FlightNumber" type="string"/>
                  <element maxOccurs="1" minOccurs="0" name="FlightDate" type="string"/>
                  <element maxOccurs="1" minOccurs="0" name="Airlinedesignator" type="string"/>
