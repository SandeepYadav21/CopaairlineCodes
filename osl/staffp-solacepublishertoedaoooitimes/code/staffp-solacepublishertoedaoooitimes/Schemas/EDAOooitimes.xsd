                  <element maxOccurs="1" minOccurs="0" name="OffsetArrivalStation" type="string"/>
                  <element maxOccurs="1" minOccurs="0" name="AcOwner" type="string"/>
                  <element maxOccurs="1" minOccurs="0" name="FlightStatus" type="string"/>
                  <element maxOccurs="1" minOccurs="0" name="ServiceType" type="string"/>
                  <element maxOccurs="1" minOccurs="0" name="OOOITimes">
                    <complexType>
                      <sequence>
                        <element maxOccurs="1" minOccurs="0" name="EstimatedTimeofDeparture" type="string"/>
                        <element maxOccurs="1" minOccurs="0" name="EstimatedTimeofArrival" type="string"/>
                        <element maxOccurs="1" minOccurs="0" name="OnTime" type="string"/>
                        <element maxOccurs="1" minOccurs="0" name="OffTime" type="string"/>
                        <element maxOccurs="1" minOccurs="0" name="OutTime" type="string"/>
                        <element maxOccurs="1" minOccurs="0" name="InTime" type="string"/>
                        <element maxOccurs="1" minOccurs="0" name="BlockFuel" type="string"/>
                        <element maxOccurs="1" minOccurs="0" name="FuelOnBoard" type="string"/>
                        <element maxOccurs="1" minOccurs="0" name="Delay1" type="string"/>
                        <element maxOccurs="1" minOccurs="0" name="Delay2" type="string"/>
                        <element maxOccurs="1" minOccurs="0" name="delayCode1" type="string"/>
                        <element maxOccurs="1" minOccurs="0" name="delayCode2" type="string"/>
                        <element maxOccurs="1" minOccurs="0" name="RemainingFuel" type="string"/>
                        <element maxOccurs="1" minOccurs="0" name="LocalTime">
                          <complexType>
                            <sequence>
                              <element maxOccurs="1" minOccurs="0" name="EstimatedTimeofDeparture" type="string"/>
                              <element maxOccurs="1" minOccurs="0" name="EstimatedTimeofArrival" type="string"/>
                              <element maxOccurs="1" minOccurs="0" name="OnTime" type="string"/>
                              <element maxOccurs="1" minOccurs="0" name="OffTime" type="string"/>
                              <element maxOccurs="1" minOccurs="0" name="OutTime" type="string"/>
                              <element maxOccurs="1" minOccurs="0" name="InTime" type="string"/>
                              <element maxOccurs="1" minOccurs="0" name="FlightDate" type="string"/>
                            </sequence>
                          </complexType>
                        </element>
                        <element maxOccurs="1" minOccurs="0" name="DateTimeFormat">
                          <complexType>
                            <sequence>
                              <element maxOccurs="1" minOccurs="0" name="EstimatedTimeofDeparture" type="string"/>
                              <element maxOccurs="1" minOccurs="0" name="EstimatedTimeofArrival" type="string"/>
                              <element maxOccurs="1" minOccurs="0" name="OnTime" type="string"/>
                              <element maxOccurs="1" minOccurs="0" name="OffTime" type="string"/>
                              <element maxOccurs="1" minOccurs="0" name="OutTime" type="string"/>
                              <element maxOccurs="1" minOccurs="0" name="InTime" type="string"/>
                              <element maxOccurs="1" minOccurs="0" name="FlightDate" type="string"/>
                            </sequence>
                          </complexType>
                        </element>
                      </sequence>
                    </complexType>
                  </element>
                </sequence>
              </complexType>
            </element>
          </sequence>
        </complexType>
      </element>
    </sequence>
  </complexType>
    
  <element name="EDAOooitimes" type="tns:EDAOooitimesSchemaType"/>
</schema>